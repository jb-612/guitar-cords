# Cloud sync (optional). Without these the app works fully on this device.
# 1. Create a Firebase project: https://console.firebase.google.com
# 2. Authentication -> Sign-in method: enable Email/Password and Google
# 3. Firestore Database -> create; then deploy the rules: npx firebase-tools deploy --only firestore:rules
# 4. Project settings -> Your apps -> Web app: copy the config values below into .env.local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
